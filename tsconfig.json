{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./",
    "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "esnext",
    "target": "esnext",
    
    // Recommended Options
    "strict": true,
    
    "moduleDetection": "force",
    "skipLibCheck": true,
  }
}
